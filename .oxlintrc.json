{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "error"
  },
  "ignorePatterns": [
    ".revisium-actions/**",
    "coverage/**",
    "dist/**",
    "examples/quick-start.ts",
    "node_modules/**",
    "scripts/packed-consumer.ts",
    "scripts/packed-surface-probe.mjs",
    "scripts/verify-package.mjs"
  ],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "plugins": ["typescript", "vitest"],
  "overrides": [
    {
      "files": ["src/pipeline/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "@dbos-inc/dbos-sdk",
                "message": "Pipeline code must depend on ports, not the DBOS SDK."
              },
              {
                "name": "typebox/schema",
                "message": "Runtime schema compilation belongs under src/validation."
              }
            ],
            "patterns": [
              {
                "regex": "^(?:\\.\\./)+dbos(?:/|$)",
                "message": "Pipeline code must not import DBOS implementations."
              },
              {
                "group": ["@dbos-inc/dbos-sdk/**"],
                "message": "Pipeline code must not import DBOS implementations."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/dbos/kernel-run-workflow.ts"],
      "rules": {
        "no-await-in-loop": "off"
      }
    },
    {
      "files": ["src/contracts/**/*.ts", "src/dbos/**/*.ts", "src/manager/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "typebox/schema",
                "message": "Runtime schema compilation belongs under src/validation."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["test/acceptance/**/*.test.ts"],
      "rules": {
        "vitest/no-disabled-tests": "off",
        "vitest/warn-todo": "off"
      }
    },
    {
      "files": ["test/package/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "src/(?!index\\.js$)",
                "message": "Package quality tests may import only the public root."
              },
              {
                "regex": "(?:^|/)(?:acceptance|dsl|fixtures|integration|unit)/",
                "message": "Package quality tests must not depend on other test layers."
              },
              {
                "regex": "^(?:\\.\\./)+support/",
                "message": "Package quality tests must not depend on shared test support."
              },
              {
                "regex": "(?:^|/)test/support/",
                "message": "Package quality tests must not depend on shared test support."
              }
            ]
          }
        ]
      }
    }
  ],
  "rules": {
    "curly": ["error", "all"],
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/no-focused-tests": "error"
  }
}
