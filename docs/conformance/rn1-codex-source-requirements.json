  "requirements": [
    {
      "id": "SR-DEP-001",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-MANIFEST",
      "locator": "/dependencies/@revisium~1revo-agent-runtime",
      "text": "Exact direct root dependency 0.1.0-alpha.0."
    },
    {
      "id": "SR-DEP-002",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-LOCK",
      "locator": "/packages/@revisium~1revo-agent-runtime@0.1.0-alpha.0",
      "text": "One exact registry/SRI resolution and approved dependency snapshot; no alternate resolver."
    },
    {
      "id": "SR-SURFACE-001",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-REPOSITORY",
      "locator": "/Repository Contract",
      "text": "Only the revo-run package root is public."
    },
    {
      "id": "SR-SURFACE-002",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/1",
      "text": "Runtime, adapter, definition, registry, bindings, handles, and internal records are root-private and non-injectable."
    },
    {
      "id": "SR-DEF-001",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/2",
      "text": "Exactly private codex@definition-v1; no fallback or dynamic selection."
    },
    {
      "id": "SR-DEF-002",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-ADR-0003",
      "locator": "/Decision",
      "text": "Definition version does not pin the Codex CLI version."
    },
    {
      "id": "SR-PLATFORM-001",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/3",
      "text": "Production support is Linux only."
    },
    {
      "id": "SR-PLATFORM-002",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-ADR-0004",
      "locator": "/Decision",
      "text": "A non-Linux run containing Codex rejects after whole-set profile resolution with agent preparation, workspace acquisition, script preparation, process launch, and DBOS admission all untouched; script-only runs are unaffected."
    },
    {
      "id": "SR-IO-001",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-ADR-0004",
      "locator": "/Decision",
      "text": "Actual Codex argv places root-scoped --ask-for-approval=never before exec, then exec-scoped --ignore-user-config."
    },
    {
      "id": "SR-IO-002",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/4",
      "text": "Actual argv ends with -- and -."
    },
    {
      "id": "SR-IO-003",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/4",
      "text": "Prompt is absent from argv and byte-identical UTF-8 stdin."
    },
    {
      "id": "SR-MODEL-001",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/5",
      "text": "model matches ^[A-Za-z0-9][A-Za-z0-9._:/-]{0,127}$ and is only the --model value."
    },
    {
      "id": "SR-AUTH-001",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/6",
      "text": "allowAmbientLogin is exactly true and host credentials are never acquired."
    },
    {
      "id": "SR-AUTH-002",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-ADR-0004",
      "locator": "/Decision",
      "text": "HOME/CODEX_HOME are captured per invocation immediately before runtime.start and supplied only through that invocation’s runtime secret/redaction path; no port-lifetime snapshot and no user config inheritance."
    },
    {
      "id": "SR-CREDENTIALS-001",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/7",
      "text": "credentials must be absent; empty or populated presence rejects pre-admission."
    },
    {
      "id": "SR-WORKSPACE-001",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/8",
      "text": "workspaceRef matches [A-Za-z][A-Za-z0-9._-]{0,127}."
    },
    {
      "id": "SR-WORKSPACE-002",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/8",
      "text": "Workspace acquisition happens per invocation, never during binding preparation or admission."
    },
    {
      "id": "SR-WORKSPACE-003",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/8",
      "text": "Each invocation derives an exclusive sibling output leaf; workspace/output paths remain process-local and non-durable."
    },
    {
      "id": "SR-TERMINAL-001",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-REVIEW",
      "locator": "/public-durable-values",
      "text": "Terminal carrier is closed and excludes runtime/process/files/environment/diagnostic fields."
    },
    {
      "id": "SR-TERMINAL-002",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/9",
      "text": "Recursive sanitization rejects secret/environment/credential/auth/token/password/generic-key shapes and captured secrets; a lexical token scanner rejects atom-started POSIX absolute tokens including root and punctuation-leading segment characters, drive absolutes, backslash UNC/device paths, and file URI tokens anywhere in terminal success or failure text; a non-file URL exemption requires full RFC3986 consumption to end, whitespace, control, or a deterministically selected rightmost full-valid external wrapper closer; unknown or out-of-grammar input invalidates the whole candidate and exposes its first slash, while wrapper characters that are RFC data remain data unless selected as the maximal valid envelope boundary; RFC URL and maximal-valid wrapper recognition is one forward O(n) parse with bounded state, so closer count does not multiply parsing work."
    },
    {
      "id": "SR-TERMINAL-003",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/9",
      "text": "Acronym credential keys such as APIKey, AWS_ACCESS_KEY_ID, JWTToken, OAuthToken, and SSHPrivateKey reject."
    },
    {
      "id": "SR-TERMINAL-004",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/9",
      "text": "Unsafe success maps only to generic revo.run.execution_failed; safe JSON is cloned and deeply frozen."
    },
    {
      "id": "SR-LIFECYCLE-001",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/10",
      "text": "Caller cancellation aborts and settles pending acquisition/start with no late runtime.start."
    },
    {
      "id": "SR-LIFECYCLE-002",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/10",
      "text": "Adapter shutdown aborts and settles pending acquisition/start and drains accepted work."
    },
    {
      "id": "SR-START-001",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/11",
      "text": "Proven pre-accept cancellation becomes cancelled; another known pre-accept rejection becomes failed."
    },
    {
      "id": "SR-START-002",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/11",
      "text": "Accepted requires an exact invocationId and execution pin."
    },
    {
      "id": "SR-START-003",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/11",
      "text": "Unexpected post-start faults and mismatched handles/lookups become recovery_required."
    },
    {
      "id": "SR-ACTIVE-001",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-ADR-0003",
      "locator": "/Decision/active-process-identity",
      "text": "Closed versioned active running/cancelling snapshots use DBOS/PostgreSQL only."
    },
    {
      "id": "SR-ACTIVE-002",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/12",
      "text": "Active save/remove complete only after DBOS acknowledgement."
    },
    {
      "id": "SR-ACTIVE-003",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/12",
      "text": "Rows load into runtime.initialize and cleanup completes before readiness opens."
    },
    {
      "id": "SR-ACTIVE-004",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/12",
      "text": "Cleanup is identity-matched; unknown/unconfirmed state is recovery_required with no replacement invocation."
    },
    {
      "id": "SR-STOP-001",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/13",
      "text": "Manager stop drains public calls, then agents while DBOS/registry remain available, then shuts down DBOS."
    },
    {
      "id": "SR-ADMISSION-001",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/14",
      "text": "Every listed unsupported/invalid assignment class rejects before workspace, scripts, or DBOS."
    },
    {
      "id": "SR-ADMISSION-002",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/14",
      "text": "Mixed and consensus sets are validated completely before any participant preparation."
    },
    {
      "id": "SR-GOLDEN-001",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/15",
      "text": "Approved architecture, requirements, golden vectors, and context vectors are repo-owned and digest-pinned."
    },
    {
      "id": "SR-CONTEXT-001",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/15",
      "text": "Every context case has concrete axis coordinates, inputs, expected observations, requirement IDs, and executable evidence."
    },
    {
      "id": "SR-EXCLUSION-001",
      "evidenceClass": "source-backed-exclusion",
      "sourceId": "SRC-ADR-0003",
      "locator": "/Consequences",
      "text": "Darwin live execution and automatic live-provider calls remain explicit source-backed exclusions."
    },
    {
      "id": "SR-VERIFY-001",
      "evidenceClass": "route-gate",
      "sourceId": "SRC-VERIFICATION",
      "locator": "/complete-clean-registry-gate",
      "text": "Targeted suites precede full disposable-DB pnpm verify and git diff --check."
    },
    {
      "id": "SR-VERIFY-002",
      "evidenceClass": "executable-vector",
      "sourceId": "SRC-VERIFICATION",
      "locator": "/registry-dependencies",
      "text": "Clean install and packed root consumer prove registry-only dependencies and root surface."
    },
    {
      "id": "SR-VERIFY-003",
      "evidenceClass": "route-gate",
      "sourceId": "SRC-VERIFICATION",
      "locator": "/workflow-and-provider-gates",
      "text": "Applicable actionlint and exact-head CI/Sonar checks pass after push."
    },
    {
      "id": "SR-VERIFY-004",
      "evidenceClass": "route-gate",
      "sourceId": "SRC-BASE",
      "locator": "/",
      "text": "Any claimed pre-existing subprocess red requires same-command evidence against the pinned base."
    },
    {
      "id": "SR-LIVE-001",
      "evidenceClass": "source-backed-exclusion",
      "sourceId": "SRC-APPROVED-ARCH",
      "locator": "/constraints/16",
      "text": "Live provider smoke is conditional on explicit human authorization and ambient login, never an automatic gate."
    }
  ]
